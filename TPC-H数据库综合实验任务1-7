-- 五、聚合统计与分组查询
-- 按供应商所在国家进行统计，输出以下信息：
-- • 国家名称（Nation.name）
-- • 供应商数量（COUNT(DISTINCT Supplier.suppkey)）
-- • 提供的零件种类数（COUNT(DISTINCT PartSupp.partkey)）
-- • 总可用库存量（SUM(PartSupp.availqty)）
-- • 平均供应价格（AVG(PartSupp.supplycost)）
-- 要求：
-- • 使用 GROUP BY 分组
-- • 仅显示总可用库存量大于 500 的国家（使用 HAVING 子句）

SELECT N.name 国家名称,
	COUNT(DISTINCT S.suppkey) 供应商数量,
	COUNT(DISTINCT PS.partkey) 提供的零件种类数,
	SUM(PS.availqty) 总可用库存量,
	AVG(PS.supplycost) 平均供应价格
FROM Nation N,Supplier S,PartSupp PS WHERE N.nationkey = S.nationkey AND S.suppkey = PS.suppkey
GROUP BY N.name
HAVING (SUM(PS.availqty)>500);


