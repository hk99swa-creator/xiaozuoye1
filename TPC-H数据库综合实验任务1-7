-- 七、库存预警触发器设计
-- 业务规则：当 PartSupp 表中某个零件-供应商组合的可用数量（availqty）低于 10
-- 时，系统应自动记录预警日志。
-- 1. 设计预警日志表（4 分）
-- 创建 StockAlert_Log 表，包含以下字段：
-- • alert_id：自增主键
-- • partkey：零件编号（INT）
-- • suppkey：供应商编号（INT）
-- • alert_time：报警时间（TIMESTAMP，默认当前时间）
-- 写出完整的 CREATE TABLE 语句。
CREATE TABLE StockAlert_Log(
alert_id INT AUTO_INCREMENT, -- 自动编号
partkey INT,
suppkey INT,
alert_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
CONSTRAINT PK_StockAlert_Log PRIMARY KEY (alert_id)
);


-- 2. 创建触发器（14 分）
-- 创建 AFTER UPDATE 触发器 trg_partsupp_lowstock，在 PartSupp 表更新后触发：
-- 当 NEW.availqty < 10 且 OLD.availqty >= 10（即由安全值跌入预警区间）时，向
-- StockAlert_Log 插入一条记录（包含 partkey、suppkey，时间自动记录）。
-- 写出完整的触发器创建语句。
DELIMITER $$

CREATE TRIGGER trg_partsupp_lowstock 
AFTER UPDATE ON PartSupp
FOR EACH ROW
BEGIN
	IF NEW.availqty < 10 AND OLD.availqty >= 10 THEN
	INSERT INTO StockAlert_Log(partkey,suppkey) VALUES
	(NEW.partkey,NEW.suppkey);
	END IF;
END $$

DELIMITER;

